# Copiar este archivo como .env antes de iniciar Docker Compose.
# Reemplazar estos valores por secretos propios fuera del entorno local.

# Contraseña del administrador de SQL Server.
MSSQL_SA_PASSWORD=CambiarPorClaveSqlSegura123!

# Contraseña del usuario restringido utilizado por FastAPI.
DB_APP_PASSWORD=CambiarPorClaveAplicacion123!

# Clave larga y aleatoria utilizada para firmar los tokens JWT.
JWT_SECRET_KEY=cambiar_por_una_clave_jwt_larga_aleatoria
