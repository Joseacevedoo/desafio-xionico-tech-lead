APP_NAME=Xionico Orders API
APP_VERSION=1.0.0
APP_ENV=development

# Conexión local a SQL Server.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=xionico_orders
DB_USER=xionico_app
DB_PASSWORD=CambiarPorClaveAplicacion123!
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Seguridad y duración de la sesión.
JWT_SECRET_KEY=cambiar_por_una_clave_jwt_larga_aleatoria
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Reglas configurables de la aplicación.
DEFAULT_CUSTOMER_CODE=CUST-DEFAULT
MAX_ORDER_ITEMS=50
MAX_ITEM_QUANTITY=10000
